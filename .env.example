# Appwrite Configuration
# Get these values from your Appwrite Console → Project Settings → API
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id_here

# Database and Collection IDs (create these in Appwrite Console)
VITE_APPWRITE_DATABASE_ID=your_database_id_here
VITE_APPWRITE_COLLECTION_BOOKS=books
VITE_APPWRITE_COLLECTION_CHAPTERS=chapters
VITE_APPWRITE_COLLECTION_CHARACTERS=characters
VITE_APPWRITE_COLLECTION_LORE_BIBLES=lore_bibles
VITE_APPWRITE_COLLECTION_PROFILES=profiles

# Hosted AI Edge Function ID (create in Appwrite Console → Functions)
# Leave empty to disable hosted AI (users must use BYOK)
VITE_APPWRITE_FUNCTION_ID=

# ──────────────────────────────────────────────────────────────
# LemonSqueezy Payment Integration
# Get these from your LemonSqueezy Dashboard
# ──────────────────────────────────────────────────────────────

# LemonSqueezy Variant IDs (from your products in LS dashboard)
# Monthly variants
VITE_LEMONSQUEEZY_VARIANT_SCRIBE=your_scribe_monthly_variant_id
VITE_LEMONSQUEEZY_VARIANT_NOVELIST=your_novelist_monthly_variant_id
VITE_LEMONSQUEEZY_VARIANT_ARCHITECT=your_architect_monthly_variant_id
VITE_LEMONSQUEEZY_VARIANT_MAESTRO=your_maestro_monthly_variant_id
# Annual variants
VITE_LEMONSQUEEZY_VARIANT_SCRIBE_ANNUAL=your_scribe_annual_variant_id
VITE_LEMONSQUEEZY_VARIANT_NOVELIST_ANNUAL=your_novelist_annual_variant_id
VITE_LEMONSQUEEZY_VARIANT_ARCHITECT_ANNUAL=your_architect_annual_variant_id
VITE_LEMONSQUEEZY_VARIANT_MAESTRO_ANNUAL=your_maestro_annual_variant_id

# Appwrite Function ID for create-checkout (get this after deploying the function)
VITE_APPWRITE_FUNCTION_CREATE_CHECKOUT_ID=
