# Appwrite Configuration
# Hardcoded defaults are in src/lib/appwrite.ts — override here if needed
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=YOUR_APPWRITE_PROJECT_ID

# Database and Collection IDs (create these in Appwrite Console)
VITE_APPWRITE_DATABASE_ID=YOUR_APPWRITE_DATABASE_ID
VITE_APPWRITE_COLLECTION_BOOKS=books
VITE_APPWRITE_COLLECTION_CHAPTERS=chapters
VITE_APPWRITE_COLLECTION_CHARACTERS=characters
VITE_APPWRITE_COLLECTION_LORE_BIBLES=lore_bibles
VITE_APPWRITE_COLLECTION_PROFILES=profiles

# Hosted AI Edge Function ID (create in Appwrite Console → Functions)
# Leave empty to disable hosted AI (users must use BYOK)
VITE_APPWRITE_FUNCTION_ID=
